# Dummy values only. Do not put real credentials in this file.
BOT_API_LISTEN=127.0.0.1:8090
DATABASE_URL=postgres://deploybot_api:CHANGE_ME@127.0.0.1:5432/deploybot?sslmode=disable
BOT_API_MIGRATE_DATABASE_URL=postgres://deploybot_migrator:CHANGE_ME@127.0.0.1:5432/deploybot?sslmode=disable
BOT_API_GOOGLE_CLIENT_ID=dummy-google-client-id
BOT_API_GOOGLE_CLIENT_SECRET=dummy-google-client-secret
